---
import { X } from '@lucide/astro'
import type { Locale } from '../types/project'
import { siteCopy } from '../i18n/ui'
import { buttonPrimary, buttonSecondary, iconControl, shell } from '../styles/classes'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = siteCopy[locale].analytics
---

<aside
  data-analytics-banner
  hidden
  class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-panel-raised shadow-panel"
  aria-label={copy.bannerLabel}
>
  <div class:list={[shell, 'flex min-h-[116px] items-center justify-between gap-8 py-5 max-[720px]:min-h-0 max-[720px]:flex-col max-[720px]:items-stretch max-[720px]:gap-4']}>
    <div class="max-w-[720px]">
      <h2 class="mb-1.5 text-lg">{copy.bannerTitle}</h2>
      <p class="mb-0 text-sm text-copy-muted">{copy.bannerBody}</p>
    </div>
    <div class="flex shrink-0 gap-2.5 max-[720px]:flex-wrap">
      <button class={buttonSecondary} type="button" data-analytics-reject>{copy.reject}</button>
      <button class={buttonPrimary} type="button" data-analytics-accept>{copy.accept}</button>
    </div>
  </div>
</aside>

<dialog
  data-analytics-dialog
  class="m-auto w-[min(560px,calc(100vw-32px))] rounded-panel border border-line bg-panel-raised p-0 text-ink shadow-panel"
  aria-labelledby="analytics-dialog-title"
>
  <form data-analytics-preferences-form class="p-7 max-[720px]:p-5" method="dialog">
    <header class="mb-6 flex items-start justify-between gap-5">
      <div>
        <h2 id="analytics-dialog-title" class="mb-2 text-2xl">{copy.dialogTitle}</h2>
        <p class="mb-0 text-sm text-copy-muted">{copy.dialogBody}</p>
      </div>
      <button class={iconControl} type="button" data-analytics-preferences-close aria-label={copy.close} title={copy.close}>
        <X size={20} stroke-width={1.8} aria-hidden="true" />
      </button>
    </header>
    <label class="flex min-h-[72px] cursor-pointer items-center justify-between gap-5 border-y border-line py-4 font-[620]">
      <span>{copy.enabled}</span>
      <input class="size-5 shrink-0 accent-brand" type="checkbox" data-analytics-enabled />
    </label>
    <p data-analytics-privacy-signal hidden class="mt-4 mb-0 text-sm text-copy-muted">{copy.privacySignal}</p>
    <div class="mt-6 flex justify-end">
      <button class={buttonPrimary} type="submit">{copy.save}</button>
    </div>
  </form>
</dialog>
