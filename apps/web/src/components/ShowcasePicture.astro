---
import type { Locale, ProjectVisual } from '../types/project'

interface Props {
  visual: ProjectVisual
  locale: Locale
  sizes: string
  priority?: boolean
}

const { visual, locale, sizes, priority = false } = Astro.props
const variants = visual.variants ?? [visual]
const responsiveSizes = priority ? sizes : `auto, ${sizes}`
---

<picture>
  <source type="image/avif" srcset={variants.map(image => `${image.avif} ${image.width}w`).join(', ')} sizes={responsiveSizes} />
  <img src={visual.src} srcset={variants.map(image => `${image.src} ${image.width}w`).join(', ')} sizes={responsiveSizes} width={visual.width} height={visual.height} alt={visual.locales[locale].alt} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding="async" />
</picture>
