---
import { ArrowRight, ArrowUpRight, BadgeCheck, BookOpen, Boxes, GitFork, Layers, Split } from '@lucide/astro'
import type { Locale, ProjectMetricsMap } from '../types/project'
import type { ProjectEntry } from '../lib/projects'
import { formatCompactNumber, formatReleaseDate } from '../lib/metrics'
import { localizePath, projectPath, siteCopy } from '../i18n/ui'
import {
  buttonPrimary,
  buttonSecondary,
  compactSectionHeading,
  eyebrow,
  iconControl,
  platformPill,
  projectTone,
  section,
  sectionDescription,
  sectionHeading,
  sectionTitle,
  shell,
} from '../styles/classes'
import EcosystemVisual from './EcosystemVisual.astro'

interface Props {
  locale: Locale
  projects: ProjectEntry[]
  metrics: ProjectMetricsMap
}

const { locale, projects, metrics } = Astro.props
const copy = siteCopy[locale]
const numberLocale = locale === 'zh-CN' ? 'zh-CN' : 'en-US'
const buttonRow = 'flex flex-wrap items-center gap-3'
const projectStatus = `mb-3 flex items-center gap-[7px] font-mono text-xs font-bold uppercase ${projectTone}`
const orbitPill = 'absolute rounded-md bg-panel-raised px-2.5 py-[7px] font-mono text-[11px] text-ink'
const orbitPositions = ['top-2 left-[92px]', 'top-[104px] -left-[18px]', 'right-[-8px] bottom-[88px]', 'bottom-[13px] left-[104px]']
---

<main id="main-content">
  <section class:list={[shell, 'grid min-h-[min(680px,calc(100dvh-128px))] grid-cols-[.82fr_1.18fr] items-center gap-16 pt-14 pb-[72px] max-[960px]:min-h-0 max-[960px]:grid-cols-1 max-[960px]:gap-[42px] max-[960px]:pt-16 max-[960px]:pb-[88px] max-[720px]:gap-[38px] max-[720px]:pt-[50px] max-[720px]:pb-[76px]']}>
    <div class="motion-safe:animate-reveal-up max-w-[540px] max-[960px]:max-w-[680px]">
      <p class={eyebrow}>{copy.hero.eyebrow}</p>
      <h1 class="mb-[22px] text-[76px] font-[740] max-[720px]:mb-[18px] max-[720px]:text-5xl">{copy.hero.title}</h1>
      <p class="mb-[30px] max-w-[470px] text-xl leading-normal text-copy-muted max-[720px]:text-lg">{copy.hero.description}</p>
      <div class={buttonRow}>
        <a class={buttonPrimary} href={`${localizePath(locale)}#projects`} data-analytics-event="navigate_section" data-analytics-section="projects">
          {copy.hero.primary}
          <ArrowRight size={18} stroke-width={1.9} aria-hidden="true" />
        </a>
        <a class={buttonSecondary} href="https://github.com/sonofmagic/weapp.dev" target="_blank" rel="noreferrer" data-analytics-event="click_outbound" data-analytics-target="site_source">
          <GitFork size={18} stroke-width={1.9} aria-hidden="true" />
          {copy.hero.secondary}
        </a>
      </div>
    </div>
    <EcosystemVisual label={copy.hero.visualLabel} />
  </section>

  <section class:list={[section, shell]} id="about">
    <header class={sectionHeading}>
      <p class={eyebrow}>{copy.about.eyebrow}</p>
      <h2 class={sectionTitle}>{copy.about.title}</h2>
      <p class={sectionDescription}>{copy.about.description}</p>
    </header>
    <dl class="m-0 grid grid-cols-3 gap-3.5 max-[720px]:grid-cols-1">
      {copy.about.items.map(item => (
        <div class="rounded-panel border border-line bg-panel-raised p-[26px]">
          <dt class="mb-3 text-lg font-[680]">{item.title}</dt>
          <dd class="m-0 leading-[1.7] text-copy-muted">{item.body}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class:list={[section, shell]} id="projects">
    <header class={sectionHeading}>
      <p class={eyebrow}>{copy.projects.eyebrow}</p>
      <h2 class={sectionTitle}>{copy.projects.title}</h2>
      <p class={sectionDescription}>{copy.projects.description}</p>
    </header>
    <div class="border-t border-line">
      {projects.map((project, index) => {
        const content = project.data.locales[locale]
        const projectMetrics = metrics[project.id]
        return (
          <article class="grid min-h-[480px] grid-cols-[.42fr_1fr] border-b border-line max-[960px]:grid-cols-[.36fr_.64fr] max-[720px]:grid-cols-1" style={`--project-accent: ${project.data.accent}`}>
            <div class="relative grid place-items-center overflow-hidden bg-[color-mix(in_srgb,var(--project-accent)_12%,var(--surface))] max-[720px]:min-h-[280px]">
              <span class:list={['absolute top-[18px] left-[18px] font-mono text-[13px] font-bold', projectTone]} aria-hidden="true">0{index + 1}</span>
              <div class="grid aspect-square w-[230px] place-items-center rounded-full bg-[color-mix(in_srgb,var(--surface-raised)_84%,transparent)] max-[960px]:w-[180px] max-[720px]:w-[190px]">
                <img class="size-[136px] object-contain" src={project.data.logo} width="180" height="180" alt={`${content.name} logo`} />
              </div>
            </div>
            <div class="flex flex-col justify-center px-[68px] py-16 max-[960px]:px-10 max-[960px]:py-12 max-[720px]:px-5 max-[720px]:pt-[38px] max-[720px]:pb-[52px]">
              <div class="flex items-start justify-between gap-6">
                <div>
                  <p class={projectStatus}><BadgeCheck size={16} stroke-width={1.9} aria-hidden="true" /> {copy.projects.status[project.data.status]}</p>
                  <h3 class="mb-4 text-4xl max-[720px]:text-[29px]">{content.name}</h3>
                </div>
                <div class="font-mono text-sm text-copy-muted">v{projectMetrics.version}</div>
              </div>
              <p class="mb-3 text-xl font-[620] max-[720px]:text-lg">{content.tagline}</p>
              <p class="mb-6 max-w-[690px] text-copy-muted">{content.description}</p>
              <div class="flex flex-wrap gap-2" aria-label={copy.project.platforms}>
                {project.data.platforms.slice(0, 5).map(platform => <span class={platformPill}>{platform}</span>)}
              </div>
              <dl class="my-[30px] flex gap-9">
                <div class="grid gap-0.5"><dt class="text-xs text-copy-muted">{copy.projects.weeklyDownloads}</dt><dd class="m-0 font-mono text-[19px] font-[720]">{formatCompactNumber(projectMetrics.weeklyDownloads, numberLocale)}</dd></div>
                <div class="grid gap-0.5"><dt class="text-xs text-copy-muted">{copy.projects.stars}</dt><dd class="m-0 font-mono text-[19px] font-[720]">{formatCompactNumber(projectMetrics.stars, numberLocale)}</dd></div>
              </dl>
              <div class={buttonRow}>
                <a class={buttonPrimary} href={project.data.docsUrl} target="_blank" rel="noreferrer" data-analytics-event="click_outbound" data-analytics-target="docs" data-analytics-project={project.id}>
                  <BookOpen size={18} stroke-width={1.9} aria-hidden="true" />
                  {copy.projects.documentation}
                </a>
                <a class="inline-flex min-h-[42px] items-center gap-[7px] px-[5px] text-sm font-[680] text-ink hover:text-brand" href={projectPath(locale, project.id)} data-analytics-event="select_project" data-analytics-project={project.id}>
                  {copy.projects.details}
                  <ArrowRight size={17} stroke-width={1.9} aria-hidden="true" />
                </a>
              </div>
            </div>
          </article>
        )
      })}
    </div>
  </section>

  <section class:list={[section, 'border-y border-line bg-panel']} id="principles">
    <div class={shell}>
      <header class={compactSectionHeading}>
        <p class={eyebrow}>{copy.principles.eyebrow}</p>
        <h2 class={sectionTitle}>{copy.principles.title}</h2>
        <p class={sectionDescription}>{copy.principles.description}</p>
      </header>
      <div class="grid grid-cols-[1.55fr_1fr] grid-rows-2 gap-3.5 max-[720px]:grid-cols-1 max-[720px]:grid-rows-none">
        {copy.principles.items.map((item, index) => {
          const icons = [Layers, Split, BadgeCheck]
          const Icon = icons[index]
          return (
            <article class:list={[
              'relative min-h-[210px] overflow-hidden rounded-panel border border-line p-[30px]',
              index === 0
                ? 'row-span-2 min-h-[438px] bg-panel-strong max-[720px]:row-auto max-[720px]:min-h-[360px]'
                : 'bg-panel-raised',
            ]}>
              <Icon class="mb-[34px] text-brand" size={28} stroke-width={1.6} aria-hidden="true" />
              <h3 class="mb-2.5 text-[23px]">{item.title}</h3>
              <p class="mb-0 max-w-[420px] text-copy-muted">{item.body}</p>
              {index === 0 && (
                <div class="absolute right-[-54px] bottom-[-54px] size-[280px] rounded-full border border-[color-mix(in_srgb,var(--accent)_42%,var(--border))]" aria-hidden="true">
                  {['WeChat', 'Alipay', 'Douyin', 'Web'].map((platform, platformIndex) => (
                    <span class:list={[orbitPill, orbitPositions[platformIndex]]}>{platform}</span>
                  ))}
                </div>
              )}
            </article>
          )
        })}
      </div>
    </div>
  </section>

  <section class:list={[section, shell, 'grid grid-cols-[.82fr_1.18fr] items-start gap-[72px] max-[960px]:grid-cols-1 max-[960px]:gap-0']} id="releases">
    <header class={compactSectionHeading}>
      <p class={eyebrow}>{copy.releases.eyebrow}</p>
      <h2 class={sectionTitle}>{copy.releases.title}</h2>
      <p class={sectionDescription}>{copy.releases.description}</p>
    </header>
    <div class="border-t border-line">
      {projects.map(project => {
        const projectMetrics = metrics[project.id]
        return (
          <article class="grid min-h-[104px] grid-cols-[44px_1fr_auto_40px] items-center gap-4 border-b border-line max-[720px]:grid-cols-[38px_1fr_auto] max-[720px]:gap-3">
            <img class="size-[42px] object-contain max-[720px]:size-9" src={project.data.logo} width="42" height="42" alt="" />
            <div>
              <h3 class="mb-1 text-base">{project.data.locales[locale].name}</h3>
              <p class="mb-0 text-xs text-copy-muted">{copy.releases.released} {formatReleaseDate(projectMetrics.releasedAt, numberLocale)}</p>
            </div>
            <strong class="font-mono text-sm">v{projectMetrics.version}</strong>
            <a class:list={[iconControl, 'max-[720px]:hidden']} href={`https://www.npmjs.com/package/${project.data.packageName}`} aria-label={`${copy.releases.viewPackage}: ${project.data.packageName}`} target="_blank" rel="noreferrer" data-analytics-event="click_outbound" data-analytics-target="package" data-analytics-project={project.id}>
              <ArrowUpRight size={19} stroke-width={1.8} aria-hidden="true" />
            </a>
          </article>
        )
      })}
    </div>
  </section>

  <section class="border-y border-line bg-panel-strong py-[72px] max-[720px]:py-[60px]">
    <div class:list={[shell, 'grid grid-cols-[90px_1fr_auto] items-center gap-9 max-[960px]:grid-cols-[72px_1fr] max-[720px]:grid-cols-1 max-[720px]:gap-6']}>
      <div class="grid aspect-square w-[90px] place-items-center rounded-panel border border-line bg-panel-raised text-brand max-[960px]:w-[72px]" aria-hidden="true"><Boxes size={46} stroke-width={1.35} /></div>
      <div>
        <p class={eyebrow}>{copy.maintainer.eyebrow}</p>
        <h2 class="mb-3 text-[34px] font-[710] max-[720px]:text-[34px]">{copy.maintainer.title}</h2>
        <p class="mb-0 max-w-[620px] text-lg text-copy-muted max-[720px]:text-base">{copy.maintainer.description}</p>
      </div>
      <a class:list={[buttonSecondary, 'max-[960px]:col-start-2 max-[960px]:w-fit max-[720px]:col-auto']} href="https://github.com/sonofmagic" target="_blank" rel="noreferrer" data-analytics-event="click_outbound" data-analytics-target="maintainer">
        <GitFork size={18} stroke-width={1.9} aria-hidden="true" />
        {copy.maintainer.action}
      </a>
    </div>
  </section>
</main>
