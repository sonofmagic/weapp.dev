---
import { ArrowRight, ArrowUpRight, BadgeCheck, BookOpen, GitFork, Layers2, Package, ScanLine, ShieldCheck } from '@lucide/astro'
import type { Locale, ProjectMetricsMap } from '../types/project'
import type { ProjectEntry } from '../lib/projects'
import { formatCompactNumber, formatReleaseDate } from '../lib/metrics'
import { localizePath, projectPath, siteCopy } from '../i18n/ui'
import { buttonPrimary, buttonSecondary, iconControl, projectTone, section, shell } from '../styles/classes'

interface Props {
  locale: Locale
  projects: ProjectEntry[]
  metrics: ProjectMetricsMap
}

const { locale, projects, metrics } = Astro.props
const copy = siteCopy[locale]
const numberLocale = locale === 'zh-CN' ? 'zh-CN' : 'en-US'
const stepIcons = [Layers2, ScanLine, Package]
const principleIcons = [Layers2, ShieldCheck, BadgeCheck]
const projectStages: Record<string, string> = locale === 'zh-CN'
  ? { 'weapp-tailwindcss': '样式', 'weapp-vite': '构建', varo: '组件' }
  : { 'weapp-tailwindcss': 'STYLE', 'weapp-vite': 'BUILD', varo: 'COMPOSE' }
---

<main id="main-content">
  <section class="home-hero">
    <div class:list={[shell, 'home-hero-grid']}>
      <div class="home-hero-copy">
        <p data-hero-enter style="--enter-delay: 0ms" class="home-kicker">{copy.hero.eyebrow}</p>
        <h1 data-hero-enter style="--enter-delay: 45ms" class="home-hero-title">{copy.hero.title}<span class="home-hero-dot" aria-hidden="true">.</span></h1>
        <p data-hero-enter style="--enter-delay: 90ms" class="home-hero-description">{copy.hero.description}</p>
        <div data-hero-enter style="--enter-delay: 135ms" class="flex flex-wrap items-center gap-3">
          <a class={buttonPrimary} href={`${localizePath(locale)}#projects`} data-analytics-event="navigate_section" data-analytics-section="projects">
            {copy.hero.primary}
            <ArrowRight size={18} stroke-width={1.9} aria-hidden="true" />
          </a>
          <a class={buttonSecondary} href="https://github.com/sonofmagic/weapp.dev" target="_blank" rel="noreferrer" data-analytics-event="click_outbound" data-analytics-target="site_source">
            <GitFork size={18} stroke-width={1.9} aria-hidden="true" />
            {copy.hero.secondary}
          </a>
        </div>
        <div data-hero-enter style="--enter-delay: 180ms" class="home-hero-meta" aria-label={copy.hero.visualLabel}>
          <span><i aria-hidden="true"></i> WebGL / 60 FPS</span>
          <span>MINI-APP TOOLCHAIN</span>
        </div>
      </div>

      <figure data-reveal data-hero-lens class="home-hero-stage" style="--reveal-delay: 120ms">
        <canvas data-webgl-canvas aria-label={copy.hero.visualLabel}></canvas>
        <div class="home-stage-grid" aria-hidden="true"></div>
        <div class="home-stage-orbit home-stage-orbit-a" aria-hidden="true"></div>
        <div class="home-stage-orbit home-stage-orbit-b" aria-hidden="true"></div>
        <div class="home-stage-readout"><span>BUILD / LIVE</span><strong>03</strong><small>targets online</small></div>
        <div class="home-stage-markers" aria-hidden="true"><span>STYLE</span><span>BUILD</span><span>COMPOSE</span></div>
        <figcaption class="sr-only">{copy.hero.visualLabel}</figcaption>
      </figure>
    </div>

    <div class:list={[shell, 'home-project-rail']} aria-label={copy.nav.projects}>
      {projects.map((project, index) => {
        const content = project.data.locales[locale]
        return (
          <a data-hero-enter style={`--enter-delay: ${220 + index * 45}ms`} class="home-project-link" href={projectPath(locale, project.id)} data-analytics-event="select_project" data-analytics-project={project.id}>
            <span class="home-project-index">{String(index + 1).padStart(2, '0')}</span>
            <img src={project.data.logo} width="34" height="34" alt="" />
            <span class="min-w-0"><strong>{content.name}</strong><small>{projectStages[project.id] ?? 'TOOL'} / {content.tagline}</small></span>
            <ArrowUpRight class="home-project-arrow" size={17} stroke-width={1.8} aria-hidden="true" />
          </a>
        )
      })}
    </div>
  </section>

  <section class="border-y border-line bg-panel" id="about">
    <div class:list={[section, shell]}>
      <header data-reveal class="mb-12 max-w-[720px]">
        <h2 class="mb-4 text-[44px] font-[680] max-[720px]:text-[34px]">{copy.about.title}</h2>
        <p class="mb-0 text-lg text-copy-muted max-[720px]:text-base">{copy.about.description}</p>
      </header>
      <ol class="m-0 grid list-none grid-cols-3 gap-0 border-y border-line p-0 max-[720px]:grid-cols-1 max-[720px]:border-b-0">
        {copy.about.items.map((item, index) => {
          const Icon = stepIcons[index]
          return (
            <li data-reveal style={`--reveal-delay: ${index * 70}ms`} class="relative min-h-[230px] border-r border-line px-7 py-8 last:border-r-0 max-[720px]:min-h-0 max-[720px]:border-r-0 max-[720px]:border-b max-[720px]:px-0">
              <div class="mb-10 flex items-center justify-between">
                <Icon class="text-brand" size={25} stroke-width={1.65} aria-hidden="true" />
                <span class="font-mono text-xs text-copy-muted">{String(index + 1).padStart(2, '0')}</span>
              </div>
              <h3 class="mb-3 text-2xl font-[660]">{item.title}</h3>
              <p class="mb-0 max-w-[340px] text-copy-muted">{item.body}</p>
            </li>
          )
        })}
      </ol>
    </div>
  </section>

  <section class:list={[section, shell]} id="projects">
    <header data-reveal class="mb-14 max-w-[720px]">
      <p class="mb-3 font-mono text-xs font-[650] text-brand">{copy.projects.eyebrow}</p>
      <h2 class="mb-4 text-[48px] font-[680] max-[720px]:text-[35px]">{copy.projects.title}</h2>
      <p class="mb-0 text-lg text-copy-muted max-[720px]:text-base">{copy.projects.description}</p>
    </header>

    <div class="grid gap-20 max-[720px]:gap-14">
      {projects.map((project, index) => {
        const content = project.data.locales[locale]
        const projectMetrics = metrics[project.id]
        const visual = project.data.visuals.primary
        const visualCopy = visual.locales[locale]
        return (
          <article data-project-row class:list={['group/project relative grid items-center gap-14 border-t border-line pt-14 first:border-t-0 first:pt-0 max-[960px]:gap-9', index === 0 ? 'grid-cols-[1.12fr_.88fr] max-[800px]:grid-cols-1' : 'grid-cols-[.82fr_1.18fr] max-[800px]:grid-cols-1']} style={`--project-accent: ${project.data.accent}`}>
            <figure data-reveal data-project-visual style={`--reveal-delay: ${index * 60}ms`} class:list={['relative m-0 overflow-hidden rounded-panel border border-line bg-panel-soft', index === 1 ? 'order-2 max-[800px]:order-none' : '']}>
              <div class="project-art" data-art={project.id} aria-label={visualCopy.alt}>
                <div class="art-chrome"><span></span><span></span><span></span><b>{project.data.packageName}</b></div>
                {project.id === 'weapp-tailwindcss' && <div class="art-tailwind"><div class="art-sidebar"><i></i><i></i><i></i><i></i></div><div class="art-canvas"><strong>utility-first</strong><span class="art-line w-4/5"></span><span class="art-line w-3/5"></span><span class="art-line w-11/12"></span><div class="art-chip-row"><em>p-4</em><em>flex</em><em>gap-2</em></div></div></div>}
                {project.id === 'weapp-vite' && <div class="art-vite"><div class="art-terminal"><span class="art-prompt">$</span> vite build --mode weapp<strong>✓ built in 1.42s</strong><small>dist/weapp / 24 modules</small></div><div class="art-bars"><i></i><i></i><i></i><i></i><i></i></div></div>}
                {project.id === 'varo' && <div class="art-varo"><div class="art-component"><span class="art-avatar"></span><span class="art-line w-3/5"></span><span class="art-line w-4/5"></span><button type="button">Install block</button></div><div class="art-registry"><i></i><i></i><i></i><i></i><i></i><i></i></div></div>}
              </div>
              <figcaption class="border-t border-line bg-panel px-4 py-3 text-xs text-copy-muted">{visualCopy.caption}</figcaption>
            </figure>

            <div data-reveal data-project-copy style={`--reveal-delay: ${80 + index * 60}ms`} class:list={[index === 1 ? 'order-1 max-[800px]:order-none' : '']}>
              <p class="mb-4 font-mono text-[10px] font-bold tracking-[0.09em] text-brand">{String(index + 1).padStart(2, '0')} / {projectStages[project.id] ?? 'TOOL'}</p>
              <div class="mb-5 flex items-center gap-3">
                <img class="size-12 object-contain" src={project.data.logo} width="48" height="48" alt="" />
                <span class:list={['inline-flex items-center gap-1.5 font-mono text-xs font-[650]', projectTone]}>
                  <BadgeCheck size={15} stroke-width={1.8} aria-hidden="true" />
                  {copy.projects.status[project.data.status]}
                </span>
              </div>
              <h3 class="mb-4 text-[38px] font-[680] [overflow-wrap:anywhere] max-[720px]:text-[30px]">{content.name}</h3>
              <p class="mb-3 text-xl font-[620]">{content.tagline}</p>
              <p class="mb-6 max-w-[590px] text-copy-muted">{content.description}</p>
              <dl class="mb-7 grid grid-cols-2 gap-8 border-y border-line py-5">
                <div><dt class="mb-1 text-xs text-copy-muted">{copy.projects.weeklyDownloads}</dt><dd class="m-0 font-mono text-xl font-[700]">{formatCompactNumber(projectMetrics.weeklyDownloads, numberLocale)}</dd></div>
                <div><dt class="mb-1 text-xs text-copy-muted">{copy.projects.stars}</dt><dd class="m-0 font-mono text-xl font-[700]">{formatCompactNumber(projectMetrics.stars, numberLocale)}</dd></div>
              </dl>
              <div class="flex flex-wrap items-center gap-3">
                <a class={buttonPrimary} href={project.data.docsUrl} target="_blank" rel="noreferrer" data-analytics-event="click_outbound" data-analytics-target="docs" data-analytics-project={project.id}>
                  <BookOpen size={18} stroke-width={1.9} aria-hidden="true" />
                  {copy.projects.documentation}
                </a>
                <a class={buttonSecondary} href={projectPath(locale, project.id)} data-analytics-event="select_project" data-analytics-project={project.id}>
                  {copy.projects.details}
                  <ArrowRight size={17} stroke-width={1.9} aria-hidden="true" />
                </a>
              </div>
            </div>
          </article>
        )
      })}
    </div>
  </section>

  <section class="border-y border-line bg-panel-soft" id="principles">
    <div class:list={[section, shell, 'grid grid-cols-[.72fr_1.28fr] gap-16 max-[900px]:grid-cols-1 max-[900px]:gap-10']}>
      <header data-reveal class="max-w-[470px]">
        <h2 class="mb-4 text-[44px] font-[680] max-[720px]:text-[34px]">{copy.principles.title}</h2>
        <p class="mb-0 text-lg text-copy-muted max-[720px]:text-base">{copy.principles.description}</p>
      </header>
      <div class="grid grid-cols-2 gap-px overflow-hidden rounded-panel border border-line bg-line max-[620px]:grid-cols-1">
        {copy.principles.items.map((item, index) => {
          const Icon = principleIcons[index]
          return (
            <article data-reveal data-principle-card style={`--reveal-delay: ${index * 70}ms`} class:list={['bg-panel p-7 transition-[background-color,transform] duration-300 hover:-translate-y-1 hover:bg-panel-strong', index === 0 ? 'row-span-2 min-h-[330px] max-[620px]:row-auto max-[620px]:min-h-0' : 'min-h-[164px]']}>
              <Icon class="mb-8 text-brand" size={25} stroke-width={1.6} aria-hidden="true" />
              <h3 class="mb-2 text-xl font-[650]">{item.title}</h3>
              <p class="mb-0 text-sm leading-[1.7] text-copy-muted">{item.body}</p>
            </article>
          )
        })}
      </div>
    </div>
  </section>

  <section class:list={[section, shell]} id="releases">
    <div class="grid grid-cols-[.75fr_1.25fr] gap-16 max-[900px]:grid-cols-1 max-[900px]:gap-10">
      <header data-reveal class="max-w-[470px]">
        <p class="mb-3 font-mono text-xs font-[650] text-brand">{copy.releases.eyebrow}</p>
        <h2 class="mb-4 text-[44px] font-[680] max-[720px]:text-[34px]">{copy.releases.title}</h2>
        <p class="mb-0 text-copy-muted">{copy.releases.description}</p>
      </header>
      <div data-reveal class="border-t border-line">
        {projects.map(project => {
          const projectMetrics = metrics[project.id]
          return (
            <article class="grid min-h-[112px] grid-cols-[48px_1fr_auto_42px] items-center gap-4 border-b border-line max-[520px]:grid-cols-[42px_1fr_auto]">
              <img class="size-11 object-contain max-[520px]:size-9" src={project.data.logo} width="44" height="44" alt="" />
              <div>
                <h3 class="mb-1 text-base font-[650]">{project.data.locales[locale].name}</h3>
                <p class="mb-0 text-xs text-copy-muted">{copy.releases.released} {formatReleaseDate(projectMetrics.releasedAt, numberLocale)}</p>
              </div>
              <strong class="font-mono text-sm">v{projectMetrics.version}</strong>
              <a class:list={[iconControl, 'max-[520px]:hidden']} href={`https://www.npmjs.com/package/${project.data.packageName}`} aria-label={`${copy.releases.viewPackage}: ${project.data.packageName}`} target="_blank" rel="noreferrer" data-analytics-event="click_outbound" data-analytics-target="package" data-analytics-project={project.id}>
                <ArrowUpRight size={19} stroke-width={1.8} aria-hidden="true" />
              </a>
            </article>
          )
        })}
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-panel">
    <div data-reveal class:list={[shell, 'grid min-h-[260px] grid-cols-[72px_1fr_auto] items-center gap-8 py-12 max-[820px]:grid-cols-[58px_1fr] max-[620px]:grid-cols-1']}>
      <img class="size-[72px] rounded-panel border border-line bg-panel-soft p-2.5 max-[820px]:size-[58px]" src="/logo.svg" width="72" height="72" alt="" />
      <div>
        <h2 class="mb-3 text-[34px] font-[670] max-[620px]:text-[30px]">{copy.maintainer.title}</h2>
        <p class="mb-0 max-w-[650px] text-copy-muted">{copy.maintainer.description}</p>
      </div>
      <a class:list={[buttonSecondary, 'max-[820px]:col-start-2 max-[820px]:w-fit max-[620px]:col-auto']} href="https://github.com/sonofmagic" target="_blank" rel="noreferrer" data-analytics-event="click_outbound" data-analytics-target="maintainer">
        <GitFork size={18} stroke-width={1.9} aria-hidden="true" />
        {copy.maintainer.action}
      </a>
    </div>
  </section>
</main>

<script is:inline>
  (() => {
    const canvas = document.querySelector('[data-webgl-canvas]')
    if (!(canvas instanceof HTMLCanvasElement)) return
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const gl = canvas.getContext('webgl', { alpha: true, antialias: false, powerPreference: 'high-performance' })
    if (!gl) {
      canvas.closest('[data-hero-lens]')?.setAttribute('data-webgl-fallback', '')
      return
    }

    const vertexSource = 'attribute vec2 p; void main(){ gl_Position=vec4(p,0.0,1.0); }'
    const fragmentSource = `precision mediump float;
      uniform vec2 u_resolution;
      uniform float u_time;
      void main(){
        vec2 uv = gl_FragCoord.xy / u_resolution.xy;
        vec2 p = (uv - 0.5) * vec2(u_resolution.x / u_resolution.y, 1.0);
        float t = u_time * 0.18;
        float grid = smoothstep(0.055, 0.0, abs(fract((p.x + t * 0.24) * 7.0) - 0.5));
        grid += smoothstep(0.055, 0.0, abs(fract((p.y - t * 0.16) * 7.0) - 0.5));
        float wave = sin(p.x * 8.0 + t * 2.0 + sin(p.y * 4.0)) * 0.5 + 0.5;
        float glow = exp(-3.8 * distance(p, vec2(0.12 * sin(t), 0.04 * cos(t * 1.4))));
        float scan = smoothstep(0.014, 0.0, abs(fract(p.y * 1.25 - t * 0.3) - 0.5));
        vec3 base = vec3(0.028, 0.09, 0.06);
        vec3 signal = vec3(0.26, 0.98, 0.62);
        vec3 color = base + signal * (grid * 0.12 + wave * 0.055 + glow * 0.42 + scan * 0.04);
        gl_FragColor = vec4(color, 1.0);
      }`

    const compile = (type, source) => {
      const shader = gl.createShader(type)
      if (!shader) return null
      gl.shaderSource(shader, source)
      gl.compileShader(shader)
      return gl.getShaderParameter(shader, gl.COMPILE_STATUS) ? shader : null
    }
    const vertex = compile(gl.VERTEX_SHADER, vertexSource)
    const fragment = compile(gl.FRAGMENT_SHADER, fragmentSource)
    if (!vertex || !fragment) {
      canvas.closest('[data-hero-lens]')?.setAttribute('data-webgl-fallback', '')
      return
    }
    const program = gl.createProgram()
    if (!program) return
    gl.attachShader(program, vertex)
    gl.attachShader(program, fragment)
    gl.linkProgram(program)
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return
    const buffer = gl.createBuffer()
    gl.bindBuffer(gl.ARRAY_BUFFER, buffer)
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW)
    gl.useProgram(program)
    const position = gl.getAttribLocation(program, 'p')
    gl.enableVertexAttribArray(position)
    gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0)
    const resolution = gl.getUniformLocation(program, 'u_resolution')
    const time = gl.getUniformLocation(program, 'u_time')
    let frame = 0
    const resize = () => {
      const ratio = Math.min(window.devicePixelRatio || 1, 1.5)
      const width = Math.max(1, Math.floor(canvas.clientWidth * ratio))
      const height = Math.max(1, Math.floor(canvas.clientHeight * ratio))
      if (canvas.width === width && canvas.height === height) return
      canvas.width = width
      canvas.height = height
      gl.viewport(0, 0, width, height)
    }
    const render = (stamp) => {
      resize()
      gl.uniform2f(resolution, canvas.width, canvas.height)
      gl.uniform1f(time, reduceMotion ? 0 : stamp * 0.001)
      gl.drawArrays(gl.TRIANGLES, 0, 3)
      if (!reduceMotion) frame = requestAnimationFrame(render)
    }
    window.addEventListener('resize', resize, { passive: true })
    render(0)
    if (reduceMotion) cancelAnimationFrame(frame)
  })()
</script>

<style is:global>
  @media (max-width: 900px) {
    .home-hero-grid { grid-template-columns: 1fr; gap: 2.2rem; min-height: 0; padding-top: 4.5rem; }
    .home-hero-copy { max-width: 42rem; }
    .home-hero-stage { min-height: min(60vw, 430px); }
  }

  @media (max-width: 620px) {
    .home-hero-grid { gap: 1.25rem; padding-top: 2.6rem; padding-bottom: 1.5rem; }
    .home-hero-title { font-size: clamp(3.25rem, 14vw, 4.5rem); }
    .home-hero-description { margin-bottom: 1.4rem; font-size: 1rem; }
    .home-hero-meta { margin-top: 1.35rem; }
    .home-hero-stage { min-height: 250px; border-radius: 8px; }
    .home-project-rail { grid-template-columns: 1fr; }
    .home-project-link, .home-project-link:first-child { grid-template-columns: 1.4rem 2rem minmax(0, 1fr) auto; padding: .85rem 0; border-right: 0; border-bottom: 1px solid color-mix(in srgb, var(--surface) 18%, transparent); }
    .home-project-link:last-child { border-bottom: 0; }
    .home-project-link img { width: 2rem; height: 2rem; }
    .art-vite, .art-varo { padding: .85rem; }
    .art-component { padding: .85rem; }
    .art-canvas { padding: 1rem; }
  }
</style>
