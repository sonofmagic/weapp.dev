---
import { ArrowRight, ArrowUpRight, BadgeCheck, BookOpen, Boxes, GitFork, Layers, Split } from '@lucide/astro'
import type { Locale, ProjectMetricsMap } from '../types/project'
import type { ProjectEntry } from '../lib/projects'
import { formatCompactNumber, formatReleaseDate } from '../lib/metrics'
import { localizePath, projectPath, siteCopy } from '../i18n/ui'
import EcosystemVisual from './EcosystemVisual.astro'

interface Props {
  locale: Locale
  projects: ProjectEntry[]
  metrics: ProjectMetricsMap
}

const { locale, projects, metrics } = Astro.props
const copy = siteCopy[locale]
const numberLocale = locale === 'zh-CN' ? 'zh-CN' : 'en-US'
---

<main id="main-content">
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">{copy.hero.eyebrow}</p>
      <h1>{copy.hero.title}</h1>
      <p class="hero-description">{copy.hero.description}</p>
      <div class="button-row">
        <a class="button button-primary" href={`${localizePath(locale)}#projects`}>
          {copy.hero.primary}
          <ArrowRight size={18} stroke-width={1.9} aria-hidden="true" />
        </a>
        <a class="button button-secondary" href="https://github.com/sonofmagic/weapp.dev" target="_blank" rel="noreferrer">
          <GitFork size={18} stroke-width={1.9} aria-hidden="true" />
          {copy.hero.secondary}
        </a>
      </div>
    </div>
    <EcosystemVisual label={copy.hero.visualLabel} />
  </section>

  <section class="section shell" id="projects">
    <header class="section-heading">
      <p class="eyebrow">{copy.projects.eyebrow}</p>
      <h2>{copy.projects.title}</h2>
      <p>{copy.projects.description}</p>
    </header>
    <div class="project-list">
      {projects.map((project, index) => {
        const content = project.data.locales[locale]
        const projectMetrics = metrics[project.id]
        return (
          <article class="project-row" style={`--project-accent: ${project.data.accent}`}>
            <div class="project-identity">
              <span class="project-index" aria-hidden="true">0{index + 1}</span>
              <div class="project-logo-wrap">
                <img src={project.data.logo} width="180" height="180" alt={`${content.name} logo`} />
              </div>
            </div>
            <div class="project-content">
              <div class="project-title-line">
                <div>
                  <p class="project-status"><BadgeCheck size={16} stroke-width={1.9} aria-hidden="true" /> {copy.projects.status[project.data.status]}</p>
                  <h3>{content.name}</h3>
                </div>
                <div class="project-version">v{projectMetrics.version}</div>
              </div>
              <p class="project-tagline">{content.tagline}</p>
              <p class="project-description">{content.description}</p>
              <div class="platform-list" aria-label={copy.project.platforms}>
                {project.data.platforms.slice(0, 5).map(platform => <span>{platform}</span>)}
              </div>
              <dl class="inline-metrics">
                <div><dt>{copy.projects.weeklyDownloads}</dt><dd>{formatCompactNumber(projectMetrics.weeklyDownloads, numberLocale)}</dd></div>
                <div><dt>{copy.projects.stars}</dt><dd>{formatCompactNumber(projectMetrics.stars, numberLocale)}</dd></div>
              </dl>
              <div class="project-actions">
                <a class="button button-primary" href={project.data.docsUrl} target="_blank" rel="noreferrer">
                  <BookOpen size={18} stroke-width={1.9} aria-hidden="true" />
                  {copy.projects.documentation}
                </a>
                <a class="text-link" href={projectPath(locale, project.id)}>
                  {copy.projects.details}
                  <ArrowRight size={17} stroke-width={1.9} aria-hidden="true" />
                </a>
              </div>
            </div>
          </article>
        )
      })}
    </div>
  </section>

  <section class="section principles-band" id="principles">
    <div class="shell">
      <header class="section-heading compact-heading">
        <p class="eyebrow">{copy.principles.eyebrow}</p>
        <h2>{copy.principles.title}</h2>
        <p>{copy.principles.description}</p>
      </header>
      <div class="principles-grid">
        {copy.principles.items.map((item, index) => {
          const icons = [Layers, Split, BadgeCheck]
          const Icon = icons[index]
          return (
            <article class:list={['principle-item', index === 0 && 'principle-featured']}>
              <Icon size={28} stroke-width={1.6} aria-hidden="true" />
              <h3>{item.title}</h3>
              <p>{item.body}</p>
              {index === 0 && (
                <div class="platform-orbit" aria-hidden="true">
                  <span>WeChat</span><span>Alipay</span><span>Douyin</span><span>Web</span>
                </div>
              )}
            </article>
          )
        })}
      </div>
    </div>
  </section>

  <section class="section shell releases-section" id="releases">
    <header class="section-heading compact-heading">
      <p class="eyebrow">{copy.releases.eyebrow}</p>
      <h2>{copy.releases.title}</h2>
      <p>{copy.releases.description}</p>
    </header>
    <div class="release-list">
      {projects.map(project => {
        const projectMetrics = metrics[project.id]
        return (
          <article class="release-item">
            <img src={project.data.logo} width="42" height="42" alt="" />
            <div class="release-name">
              <h3>{project.data.locales[locale].name}</h3>
              <p>{copy.releases.released} {formatReleaseDate(projectMetrics.releasedAt, numberLocale)}</p>
            </div>
            <strong>v{projectMetrics.version}</strong>
            <a class="icon-link" href={`https://www.npmjs.com/package/${project.data.packageName}`} aria-label={`${copy.releases.viewPackage}: ${project.data.packageName}`} target="_blank" rel="noreferrer">
              <ArrowUpRight size={19} stroke-width={1.8} aria-hidden="true" />
            </a>
          </article>
        )
      })}
    </div>
  </section>

  <section class="maintainer-band">
    <div class="shell maintainer-inner">
      <div class="maintainer-mark" aria-hidden="true"><Boxes size={46} stroke-width={1.35} /></div>
      <div>
        <p class="eyebrow">{copy.maintainer.eyebrow}</p>
        <h2>{copy.maintainer.title}</h2>
        <p>{copy.maintainer.description}</p>
      </div>
      <a class="button button-secondary" href="https://github.com/sonofmagic" target="_blank" rel="noreferrer">
        <GitFork size={18} stroke-width={1.9} aria-hidden="true" />
        {copy.maintainer.action}
      </a>
    </div>
  </section>
</main>
