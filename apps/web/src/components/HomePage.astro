---
import type { Locale, ProjectMetricsMap } from '../types/project'
import type { ProjectEntry } from '../lib/projects'
import { getHomeProjects } from '../lib/home'
import '../styles/home.css'
import HomeHero from './home/HomeHero.astro'
import HomeAbout from './home/HomeAbout.astro'
import HomeProjects from './home/HomeProjects.astro'
import HomeCommercial from './home/HomeCommercial.astro'
import HomeVision from './home/HomeVision.astro'
import HomeReleases from './home/HomeReleases.astro'
import HomeCollaboration from './home/HomeCollaboration.astro'
import ToolchainMap from './ToolchainMap.astro'
import ProjectSelector from './ProjectSelector.astro'

interface Props {
  locale: Locale
  projects: ProjectEntry[]
  metrics: ProjectMetricsMap
}

const { locale, projects, metrics } = Astro.props
const homeProjects = await getHomeProjects(projects)
---

<main id="main-content">
  <HomeHero locale={locale} projects={homeProjects} />
  <section class="home-toolchain-shell"><div class="mx-auto max-w-[1240px] px-6 max-[720px]:px-4"><ToolchainMap locale={locale} projects={projects} /></div></section>
  <section class="home-toolchain-shell"><div class="mx-auto max-w-[1240px] px-6 max-[720px]:px-4"><ProjectSelector locale={locale} projects={projects} /></div></section>
  <HomeAbout locale={locale} />
  <HomeProjects locale={locale} projects={homeProjects} metrics={metrics} />
  <HomeVision locale={locale} />
  <HomeReleases locale={locale} projects={projects} metrics={metrics} />
  <HomeCommercial locale={locale} />
  <HomeCollaboration locale={locale} />
</main>
