---
import type { Locale } from '../types/project'
import type { ProjectEntry } from '../lib/projects'
import { projectPath } from '../i18n/ui'
import { getToolchainProjects } from '../lib/toolchain'
import { buttonPrimary, pageTitle, section, shell } from '../styles/classes'
interface Props { locale: Locale; projects: ProjectEntry[] }
const { locale, projects } = Astro.props
const copy = locale === 'zh-CN' ? { eyebrow: '工具链项目', title: '选择你现在需要的那一层', description: '五个项目按开发流程排列。先接最痛的一层，之后再按需要叠加。', docs: '阅读文档', details: '项目详情', stable: '稳定', beta: '测试', planned: '规划中', map: '工具链角色' } : { eyebrow: 'Toolchain projects', title: 'Choose the layer you need now', description: 'Five projects, ordered by the development flow. Start with the sharpest pain and add another layer when you need it.', docs: 'Read docs', details: 'Project details', stable: 'Stable', beta: 'Beta', planned: 'Planned', map: 'Toolchain role' }
const roleLabels = locale === 'zh-CN' ? { engineering: '工程与构建', styling: '样式系统', components: '组件与交付', data: '本地数据', migration: 'Taro / React 迁移' } : { engineering: 'Engineering', styling: 'Styling', components: 'Components', data: 'Local data', migration: 'Taro / React migration' }
const maturityLabels = locale === 'zh-CN' ? { all: '全部成熟度', stable: '稳定', beta: '测试', planned: '规划中' } : { all: 'All maturity', stable: 'Stable', beta: 'Beta', planned: 'Planned' }
const allPlatforms = [...new Set(getToolchainProjects(projects).flatMap(({ project }) => project.data.platforms))].sort()
---
<main id="main-content"><section class:list={[section, shell, 'projects-index-hero']}><p class="mb-4 font-mono text-xs font-[650] uppercase tracking-[.12em] text-brand">{copy.eyebrow}</p><h1 class={pageTitle}>{copy.title}</h1><p class="mt-6 max-w-[680px] text-lg text-copy-muted">{copy.description}</p></section><section class:list={[section, shell, 'border-t border-line']}><div class="projects-index-filters" data-project-filters role="group" aria-controls="toolchain-project-list" aria-label={locale === 'zh-CN' ? '筛选工具链项目' : 'Filter toolchain projects'}><label>{locale === 'zh-CN' ? '工具链角色' : 'Role'}<select disabled data-filter-role aria-controls="toolchain-project-list" aria-label={locale === 'zh-CN' ? '按工具链角色筛选' : 'Filter by toolchain role'}><option value="">{locale === 'zh-CN' ? '全部角色' : 'All roles'}</option>{Object.entries(roleLabels).map(([role, label]) => <option value={role}>{label}</option>)}</select></label><label>{locale === 'zh-CN' ? '成熟度' : 'Maturity'}<select disabled data-filter-maturity aria-controls="toolchain-project-list" aria-label={locale === 'zh-CN' ? '按成熟度筛选' : 'Filter by maturity'}><option value="">{maturityLabels.all}</option><option value="stable">{maturityLabels.stable}</option><option value="beta">{maturityLabels.beta}</option><option value="planned">{maturityLabels.planned}</option></select></label><label>{locale === 'zh-CN' ? '平台' : 'Platform'}<select disabled data-filter-platform aria-controls="toolchain-project-list" aria-label={locale === 'zh-CN' ? '按平台筛选' : 'Filter by platform'}><option value="">{locale === 'zh-CN' ? '全部平台' : 'All platforms'}</option>{allPlatforms.map(platform => <option value={platform}>{platform}</option>)}</select></label><button type="button" data-filter-reset disabled aria-controls="toolchain-project-list" class="projects-index-reset">{locale === 'zh-CN' ? '重置筛选' : 'Reset filters'}</button><output data-filter-count aria-live="polite">{getToolchainProjects(projects).length} {locale === 'zh-CN' ? '个项目' : 'projects'}</output></div><noscript><p class="projects-filter-note">{locale === 'zh-CN' ? '启用 JavaScript 后可筛选项目。以下展示全部五个项目。' : 'Enable JavaScript to filter. All five projects are listed below.'}</p></noscript><div class="projects-filter-empty" data-filter-empty hidden><h2>{locale === 'zh-CN' ? '没有符合这些条件的项目' : 'No projects match these filters'}</h2><p>{locale === 'zh-CN' ? '试试减少筛选条件，或重置后查看全部五个项目。' : 'Try fewer filters, or reset to browse all five projects.'}</p><button type="button" data-filter-clear class="projects-index-reset">{locale === 'zh-CN' ? '查看全部项目' : 'Show all projects'}</button></div><div id="toolchain-project-list" class="projects-index-list">{getToolchainProjects(projects).map(({ project, role }, index) => { const content = project.data.locales[locale]; return <article data-project-card data-role={role} data-maturity={project.data.status} data-platforms={project.data.platforms.join('|')} data-reveal style={`--reveal-delay:${index * 50}ms`}><div class="projects-index-number">{String(index + 1).padStart(2, '0')}</div><img src={project.data.logo} width="52" height="52" alt="" loading="lazy" decoding="async" /><div class="projects-index-copy"><div class="flex flex-wrap items-center gap-2"><span class="font-mono text-xs font-[650] text-brand">{roleLabels[role]}</span><span class="projects-status">{copy[project.data.status]}</span></div><h2>{content.name}</h2><p>{content.description}</p><div class="flex flex-wrap gap-2">{project.data.platforms.map(platform => <span class="projects-platform">{platform}</span>)}{project.data.roadmap?.length ? <span class="projects-platform">{project.data.roadmap.length} {locale === 'zh-CN' ? '项路线' : project.data.roadmap.length === 1 ? 'roadmap item' : 'roadmap items'}</span> : null}</div></div><div class="projects-index-actions"><a class={buttonPrimary} href={project.data.docsUrl} target="_blank" rel="noreferrer" aria-label={`${copy.docs}: ${content.name}`}>{copy.docs}</a><a class="inline-flex min-h-11 items-center justify-center px-2 text-sm font-[650] text-copy-muted hover:text-ink" href={projectPath(locale, project.id)} aria-label={`${copy.details}: ${content.name}`}>{copy.details}</a></div></article> })}</div></section></main>
<script>
  const root = document.querySelector('[data-project-filters]')
  if (root) {
    const cards = [...document.querySelectorAll<HTMLElement>('[data-project-card]')]
    const role = root.querySelector<HTMLSelectElement>('[data-filter-role]')!
    const maturity = root.querySelector<HTMLSelectElement>('[data-filter-maturity]')!
    const platform = root.querySelector<HTMLSelectElement>('[data-filter-platform]')!
    const reset = root.querySelector<HTMLButtonElement>('[data-filter-reset]')!
    const count = root.querySelector<HTMLOutputElement>('[data-filter-count]')!
    const empty = document.querySelector<HTMLElement>('[data-filter-empty]')!
    const clear = document.querySelector<HTMLButtonElement>('[data-filter-clear]')!
    const apply = () => {
      let visible = 0
      cards.forEach((card) => {
        const matches = (!role.value || card.dataset.role === role.value) && (!maturity.value || card.dataset.maturity === maturity.value) && (!platform.value || card.dataset.platforms?.split('|').includes(platform.value))
        card.hidden = !matches
        if (matches) visible += 1
      })
      empty.hidden = visible !== 0
      count.textContent = `${visible} ${document.documentElement.lang.startsWith('zh') ? '个项目' : visible === 1 ? 'project' : 'projects'}`
    }
    maturity.addEventListener('change', apply)
    role.addEventListener('change', apply)
    platform.addEventListener('change', apply)
    const resetFilters = () => {
      role.value = ''
      maturity.value = ''
      platform.value = ''
      apply()
      role.focus()
    }
    reset.addEventListener('click', resetFilters)
    clear.addEventListener('click', resetFilters)
    apply()
    ;[role, maturity, platform, reset].forEach(control => { control.disabled = false })
  }
</script>
<style>
  .projects-index-hero { padding-top: 3.5rem; padding-bottom: 3.5rem; }
  .projects-index-list article[hidden], .projects-filter-empty[hidden] { display: none; }
  .projects-filter-note, .projects-filter-empty p { color: var(--muted); line-height: 1.6; }
  .projects-filter-empty { padding: 2rem 0; border-top: 1px solid var(--border); }
  .projects-filter-empty h2 { margin: 0; font: 660 1.5rem/1.2 var(--font-display); }
  .projects-filter-empty p { margin: .75rem 0 1.25rem; max-width: 65ch; }
  .projects-index-filters :disabled { cursor: not-allowed; opacity: .65; }
  .projects-index-list { border-top: 1px solid var(--border); }
  .projects-index-filters { display:flex; flex-wrap:wrap; gap:1rem; align-items:end; margin-bottom:1.25rem; }
  .projects-index-filters label { display:grid; gap:.4rem; color:var(--muted); font:650 .7rem/1 var(--font-mono); text-transform:uppercase; }
  .projects-index-filters select { min-width:10rem; min-height:2.5rem; border:1px solid var(--border); padding:.5rem .65rem; background:var(--surface); color:var(--text); font:400 .9rem/1.2 var(--font-sans); text-transform:none; }
  .projects-index-filters output { margin-left:auto; color:var(--muted); font:650 .75rem/1 var(--font-mono); }
  .projects-index-reset { min-height:2.5rem; border:1px solid var(--border); padding:.5rem .7rem; background:transparent; color:var(--muted); font:650 .7rem/1 var(--font-mono); cursor:pointer; }
  .projects-index-reset:hover,.projects-index-reset:focus-visible { border-color:var(--accent); color:var(--text); }
  .projects-index-list article { display: grid; grid-template-columns: 2rem 3.25rem minmax(0, 1fr) auto; gap: 1.25rem; align-items: start; padding: 1.5rem 0; border-bottom: 1px solid var(--border); }
  .projects-index-number { color: var(--accent); font: 650 .75rem/1 var(--font-mono); padding-top: .35rem; }
  .projects-index-list img { width: 3.25rem; height: 3.25rem; object-fit: contain; }
  .projects-index-copy h2 { margin: .55rem 0 .4rem; font: 680 1.5rem/1.15 var(--font-display); overflow-wrap: anywhere; }
  .projects-index-copy p { max-width: 680px; margin: 0 0 .9rem; color: var(--muted); font-size: .92rem; line-height: 1.65; }
  .projects-status,.projects-platform { display: inline-flex; width: fit-content; border: 1px solid var(--border); padding: .28rem .5rem; color: var(--muted); font: 650 .7rem/1 var(--font-mono); }
  .projects-index-actions { display: flex; flex-direction: column; align-items: stretch; gap: .4rem; min-width: 112px; }
  @media (max-width:720px) { .projects-index-list article { grid-template-columns: 1.75rem 2.75rem minmax(0,1fr); gap: .8rem; } .projects-index-list img { width: 2.75rem; height: 2.75rem; } .projects-index-actions { grid-column: 3; flex-direction: row; align-items: center; } }
</style>
