---
import { ArrowUpRight, GitFork, Rss, SlidersHorizontal } from '@lucide/astro'
import type { Locale } from '../types/project'
import type { ProjectEntry } from '../lib/projects'
import { localizePath, projectPath, siteCopy } from '../i18n/ui'
import { shell, wordmark, wordmarkMark } from '../styles/classes'

interface Props {
  locale: Locale
  projects: ProjectEntry[]
}

const { locale, projects } = Astro.props
const copy = siteCopy[locale]
---

<footer class="border-t border-line bg-panel-soft pt-16 pb-6">
  <div class:list={[shell, 'grid grid-cols-[1.5fr_.75fr_.75fr] gap-14 max-[720px]:grid-cols-2 max-[720px]:gap-x-6 max-[720px]:gap-y-10']}>
    <div class="max-[720px]:col-span-2">
      <a class={wordmark} href={localizePath(locale)}>
        <img class={wordmarkMark} src="/logo.svg" width="64" height="64" alt="" />
        <span>weapp.dev</span>
      </a>
      <p class="mt-5 mb-0 max-w-[410px] text-sm leading-[1.7] text-copy-muted">{copy.footer.description}</p>
    </div>
    <div>
      <h2 class="mb-4 font-mono text-xs font-[650] text-copy-muted">{copy.footer.projects}</h2>
      {projects.map(project => (
        <a class="mb-3 flex w-fit items-center gap-1.5 font-display text-sm font-[590] hover:text-brand" href={projectPath(locale, project.id)} data-analytics-event="select_project" data-analytics-project={project.id}>
          {project.data.locales[locale].name}
          <ArrowUpRight size={14} stroke-width={1.8} aria-hidden="true" />
        </a>
      ))}
      <a class="mb-3 flex w-fit items-center gap-1.5 font-display text-sm font-[590] hover:text-brand" href="https://sqlite.weapp.dev/" target="_blank" rel="noreferrer" data-analytics-event="click_outbound" data-analytics-target="sqlite_docs">
        weapp-sqlite
        <ArrowUpRight size={14} stroke-width={1.8} aria-hidden="true" />
      </a>
    </div>
    <div>
      <h2 class="mb-4 font-mono text-xs font-[650] text-copy-muted">{copy.footer.resources}</h2>
      <a class="mb-3 flex w-fit items-center gap-2 text-sm hover:text-brand" href="https://github.com/sonofmagic/weapp.dev" target="_blank" rel="noreferrer" data-analytics-event="click_outbound" data-analytics-target="site_source">
        <GitFork size={15} stroke-width={1.8} aria-hidden="true" />
        {copy.footer.source}
      </a>
      <a class="mb-3 flex w-fit items-center gap-2 text-sm hover:text-brand" href={localizePath(locale, '/privacy/')}>{copy.footer.privacy}</a>
      <a class="mb-3 flex w-fit items-center gap-2 text-sm hover:text-brand" href={localizePath(locale, '/pricing/')} data-analytics-event="navigate_page" data-analytics-page="pricing">{copy.nav.pricing}</a>
      <a class="mb-3 flex w-fit items-center gap-2 text-sm hover:text-brand" href="/releases.xml" data-analytics-event="navigate_section" data-analytics-section="release_feed">
        <Rss size={15} stroke-width={1.8} aria-hidden="true" />
        {copy.footer.releases}
      </a>
    </div>
  </div>
  <div class:list={[shell, 'mt-14 flex items-center justify-between gap-5 border-t border-line pt-5 text-xs text-copy-muted max-[720px]:flex-col max-[720px]:items-start']}>
    <span>© {new Date().getFullYear()} {copy.footer.copyright}</span>
    <div class="flex flex-wrap items-center gap-5">
      <button class="inline-flex cursor-pointer items-center gap-1.5 border-0 bg-transparent p-0 hover:text-brand" type="button" data-analytics-preferences-open>
        <SlidersHorizontal size={14} stroke-width={1.8} aria-hidden="true" />
        {copy.footer.analyticsPreferences}
      </button>
      <a class="hover:text-brand" href="https://github.com/sonofmagic/weapp.dev/blob/main/LICENSE">MIT License</a>
    </div>
  </div>
</footer>
