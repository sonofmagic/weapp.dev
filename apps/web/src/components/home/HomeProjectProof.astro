---
import type { Locale } from '../../types/project'
import type { ProjectDefinition } from '../../types/project'
import type { HomeDemoKind } from '../../lib/home-projects'
import { siteCopy } from '../../i18n/ui'
import { defaultStyle, styleCode } from './demos/style'
import { buildExample } from './demos/build'
import { registryCode } from './demos/registry'
import { sqliteCode } from './demos/sqlite'
import { migrationCode } from './demos/migration'
import type { CodePart } from './demos/code'
import CodePanel from './demos/CodePanel.astro'
import './demos/demo.css'

interface Props {
  kind: HomeDemoKind
  locale: Locale
  projectName: string
  status?: ProjectDefinition['status']
  proof?: ProjectDefinition['proof']
}

const { kind, locale, projectName, status, proof: projectProof } = Astro.props
const proof = siteCopy[locale].projects.proof
const build = buildExample(0)

const artifacts: Record<HomeDemoKind, { label: string, file: string, parts: CodePart[], command?: string }> = {
  style: {
    label: proof.styleLabel,
    file: proof.styleFile,
    parts: styleCode(defaultStyle, locale === 'zh-CN' ? '开始构建' : 'Start building'),
  },
  build: {
    label: proof.buildLabel,
    file: proof.buildFile,
    parts: build.parts,
    command: build.command,
  },
  registry: {
    label: proof.registryLabel,
    file: proof.registryFile,
    parts: registryCode(['button', 'input', 'card']),
  },
  sqlite: {
    label: proof.sqliteLabel,
    file: proof.sqliteFile,
    parts: sqliteCode(locale),
  },
  migration: {
    label: proof.migrationLabel,
    file: 'terminal',
    parts: migrationCode(locale),
  },
}

const artifact = artifacts[kind]
const planned = status === 'planned'
---

<aside class="home-project-proof" aria-label={`${projectName} · ${artifact.label}`}>
  <div class="home-project-proof-heading">
    <span class="home-project-proof-label">{artifact.label}</span>
  </div>
  {planned ? <p class="home-project-proof-planned">{locale === 'zh-CN' ? '规划中 · 当前不提供可安装命令' : 'Planned · no install command is available yet'}</p> : artifact.command ? <p class="home-project-proof-command"><code>{artifact.command}</code></p> : null}
  {planned && projectProof?.length ? <ul class="home-project-proof-list">{projectProof.map(item => <li>{typeof item === 'string' ? item : item[locale]}</li>)}</ul> : <CodePanel parts={planned ? [{ text: 'status: planned\\napi: to be confirmed\\nplatforms: to be confirmed' }] : artifact.parts} locale={locale} filename={planned ? 'planning.md' : artifact.file} />}
</aside>
<style>
  .home-project-proof-planned { margin: 0; color: var(--muted); font: 650 .75rem/1.5 var(--font-mono); }
  .home-project-proof-list { display:grid; gap:.5rem; margin:0; padding:.8rem 1rem .9rem 2rem; color:var(--muted); font:500 .75rem/1.5 var(--font-mono); }
</style>
