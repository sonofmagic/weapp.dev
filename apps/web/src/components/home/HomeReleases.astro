---
import { ArrowUpRight } from '@lucide/astro'
import type { Locale, ProjectMetricsMap } from '../../types/project'
import type { ProjectEntry } from '../../lib/projects'
import { formatReleaseDate } from '../../lib/metrics'
import { homeSection, iconControl, sectionTitle, shell } from '../../styles/classes'
import { siteCopy } from '../../i18n/ui'

interface Props {
  locale: Locale
  projects: ProjectEntry[]
  metrics: ProjectMetricsMap
}

const { locale, projects, metrics } = Astro.props
const copy = siteCopy[locale]
const numberLocale = locale === 'zh-CN' ? 'zh-CN' : 'en-US'
---

<section class:list={[homeSection, shell]} id="releases">
  <div class="grid grid-cols-[.75fr_1.25fr] gap-12 max-[900px]:grid-cols-1 max-[900px]:gap-8">
    <header data-reveal class="max-w-[470px]">
      <h2 class={sectionTitle}>{copy.releases.title}</h2>
      <p class="mb-0 text-copy-muted">{copy.releases.description}</p>
    </header>
    <div data-reveal class="border-t border-line">
      {projects.map(project => {
        const projectMetrics = metrics[project.id] ?? { version: 'planned', releasedAt: '2026-01-01T00:00:00.000Z', stars: 0, weeklyDownloads: 0, fetchedAt: '2026-01-01T00:00:00.000Z' }
        return (
          <article class="grid min-h-[96px] grid-cols-[48px_1fr_auto_42px] items-center gap-4 border-b border-line max-[520px]:grid-cols-[42px_1fr_auto]">
            <img class="size-11 object-contain max-[520px]:size-9" src={project.data.logo} width="44" height="44" alt="" />
            <div>
              <h3 class="mb-1 text-base font-[650]">{project.data.locales[locale].name}</h3>
              <p class="mb-0 text-xs text-copy-muted">{copy.releases.released} {formatReleaseDate(projectMetrics.releasedAt, numberLocale)}</p>
            </div>
            <strong class="font-mono text-sm">v{projectMetrics.version}</strong>
            <a class:list={[iconControl, 'max-[520px]:hidden']} href={`https://www.npmjs.com/package/${project.data.packageName}`} aria-label={`${copy.releases.viewPackage}: ${project.data.packageName}`} target="_blank" rel="noreferrer" data-analytics-event="click_outbound" data-analytics-target="package" data-analytics-project={project.id}>
              <ArrowUpRight size={19} stroke-width={1.8} aria-hidden="true" />
            </a>
          </article>
        )
      })}
    </div>
  </div>
</section>
