---
import type { Locale, ProjectMetricsMap } from '../../types/project'
import type { HomeProject } from '../../lib/home-projects'
import { homeSection, sectionTitle, shell } from '../../styles/classes'
import HomeProjectRow from './HomeProjectRow.astro'
import { siteCopy } from '../../i18n/ui'

interface Props {
  locale: Locale
  projects: HomeProject[]
  metrics: ProjectMetricsMap
}

const { locale, projects, metrics } = Astro.props
const copy = siteCopy[locale]
---

<section class:list={[homeSection, shell]} id="projects">
  <header data-reveal class="mb-10 max-w-[720px]">
    <p class="mb-3 font-mono text-xs font-[650] text-brand">{copy.projects.eyebrow}</p>
    <h2 class={sectionTitle}>{copy.projects.title}</h2>
    <p class="mb-0 text-lg text-copy-muted max-[720px]:text-base">{copy.projects.description}</p>
  </header>

  <div class="grid gap-12 max-[720px]:gap-10">
    {projects.map((project, index) => (
      <HomeProjectRow locale={locale} project={project} index={index} metrics={metrics[project.id]} />
    ))}
  </div>
</section>
