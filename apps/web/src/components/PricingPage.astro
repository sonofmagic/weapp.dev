---
import { ArrowRight, ChevronDown, ExternalLink, GitFork, Heart } from '@lucide/astro'
import type { Locale } from '../types/project'
import { localizePath, siteCopy } from '../i18n/ui'
import { loadPublicSponsors } from '../lib/sponsors'
import { buttonPrimary, buttonSecondary, featuredTitle, pageTitle, section, sectionTitle, shell } from '../styles/classes'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = siteCopy[locale]
const pricing = copy.pricing
const sponsorSnapshot = await loadPublicSponsors()
const publicSponsors = sponsorSnapshot.items
const githubUrl = 'https://github.com/sonofmagic/weapp.dev'
---

<main id="main-content">
  <section class="pricing-hero" aria-labelledby="pricing-title">
    <div class:list={[shell, 'pricing-hero-inner']}>
      <div data-reveal>
        <p class="mb-4 font-mono text-xs font-[650] uppercase tracking-[0.12em] text-brand">{pricing.eyebrow}</p>
        <h1 id="pricing-title" class:list={[pageTitle, 'mb-6 max-w-[780px]']}>{pricing.title}</h1>
        <p class="mb-8 max-w-[650px] text-xl leading-[1.6] text-copy-muted max-[720px]:text-base">{pricing.description}</p>
        <div class="flex flex-wrap items-center gap-3">
          <a class={buttonPrimary} href="#sponsor" data-analytics-event="navigate_section" data-analytics-section="pricing_hero_sponsor">
            {pricing.sponsorAction}
            <ArrowRight size={17} stroke-width={1.9} aria-hidden="true" />
          </a>
          <a class={buttonSecondary} href="#services" data-analytics-event="navigate_section" data-analytics-section="pricing_hero_services">
            {pricing.servicesTitle}
            <ArrowRight size={17} stroke-width={1.9} aria-hidden="true" />
          </a>
          <a class="inline-flex min-h-11 items-center gap-2 px-2 text-sm font-[650] text-copy-muted hover:text-ink" href={localizePath(locale, '/sponsors/')} data-analytics-event="navigate_page" data-analytics-page="sponsors">{locale === 'zh-CN' ? '查看赞助图谱' : 'Explore sponsor graph'}</a>
        </div>
      </div>
      <aside class="pricing-hero-note" data-reveal style="--reveal-delay: 120ms">
        <span class="pricing-note-line" aria-hidden="true"></span>
        <p>{pricing.early}</p>
      </aside>
    </div>
  </section>

  <section class="border-y border-line bg-panel" id="sponsor" aria-labelledby="pricing-sponsor-title">
    <div class:list={[section, shell]}>
      <header data-reveal class="mb-10 max-w-[760px]">
        <p class="mb-3 font-mono text-xs font-[650] text-brand">{pricing.sponsorKicker}</p>
        <h2 id="pricing-sponsor-title" class={sectionTitle}>{pricing.sponsorTitle}</h2>
        <p class="mb-0 max-w-[650px] text-lg text-copy-muted max-[720px]:text-base">{pricing.sponsorDescription}</p>
      </header>

      <div class="pricing-sponsor-split">
        <div data-reveal class="pricing-sponsor-grid">
          {pricing.sponsorTiers.map((tier, index) => (
            <article class="pricing-sponsor-tier" style={`--reveal-delay: ${index * 50}ms`} aria-labelledby={`pricing-sponsor-tier-title-${index + 1}`} aria-describedby={`pricing-sponsor-tier-cadence-${index + 1} pricing-sponsor-tier-body-${index + 1}`}>
              <Heart class="mb-5 text-brand" size={22} stroke-width={1.7} aria-hidden="true" />
              <h3 id={`pricing-sponsor-tier-title-${index + 1}`} class="mb-2 text-lg font-[660]">{tier.name}</h3>
              <strong class="mb-1 block font-mono text-2xl font-[720] leading-none">{tier.price}</strong>
              <span id={`pricing-sponsor-tier-cadence-${index + 1}`} class="mb-4 block text-xs text-copy-muted">{tier.cadence}</span>
              <p id={`pricing-sponsor-tier-body-${index + 1}`} class="mb-5 text-sm leading-[1.7] text-copy-muted">{tier.body}</p>
              <a class:list={['pricing-sponsor-button', buttonSecondary]} href={githubUrl} target="_blank" rel="noopener noreferrer" data-analytics-event="click_outbound" data-analytics-target={`sponsor_${index + 1}`}>
                {pricing.sponsorAction}
                <ExternalLink size={16} stroke-width={1.8} aria-hidden="true" />
              </a>
            </article>
          ))}
        </div>

        <aside data-reveal class="pricing-allocation-panel" style="--reveal-delay: 80ms">
          <p class="mb-2 font-mono text-xs font-[650] text-brand">{pricing.allocationHeading}</p>
          <p class="mb-6 text-sm leading-[1.7] text-copy-muted">{pricing.sponsorAllocation}</p>
          <div class="pricing-allocation-stack">
            {pricing.sponsorAllocationBuckets.map((bucket, index) => (
              <article aria-labelledby={`pricing-allocation-title-${index + 1}`} aria-describedby={`pricing-allocation-body-${index + 1}`}>
                <strong class="mb-1 block font-mono text-2xl font-[720] leading-none">{bucket.share}</strong>
                <h3 id={`pricing-allocation-title-${index + 1}`} class="mb-1 text-base font-[660]">{bucket.name}</h3>
                <p id={`pricing-allocation-body-${index + 1}`} class="mb-0 text-sm leading-[1.7] text-copy-muted">{bucket.body}</p>
              </article>
            ))}
          </div>
          <a class="mt-6 inline-flex items-center gap-2 text-sm font-[650] hover:text-brand" href={localizePath(locale, '/contributors/')} data-analytics-event="navigate_page" data-analytics-page="contributors">
            {pricing.sponsorAllocationAction}
            <ArrowRight size={16} stroke-width={1.8} aria-hidden="true" />
          </a>
        </aside>
      </div>

      <p data-reveal class="pricing-sponsor-note mt-10 mb-0 max-w-[720px] text-xs leading-[1.7] text-copy-muted">{pricing.sponsorNote}</p>
      <div data-reveal class="pricing-public-sponsors">
        <h3 class="mb-2 text-lg font-[660]">{pricing.sponsorSites}</h3>
        {publicSponsors.length === 0 ? <p class="mb-0 text-sm text-copy-muted">{pricing.sponsorEmpty}</p> : <div class="pricing-public-sponsor-list">
          {(['gold', 'silver', 'bronze', 'supporter'] as const).map(tier => {
            const sponsors = publicSponsors.filter(sponsor => sponsor.tier === tier)
            if (!sponsors.length) return null
            return <div class="pricing-public-sponsor-group" aria-labelledby={`pricing-public-sponsor-tier-${tier}`}>
              <p id={`pricing-public-sponsor-tier-${tier}`} class="mb-3 font-mono text-xs font-[650] text-brand">{pricing.sponsorTierLabels[tier]}</p>
              <ul class="m-0 flex flex-wrap gap-3 p-0 list-none">
                {sponsors.map(sponsor => <li><a class="pricing-public-sponsor" href={sponsor.kind === 'business' ? sponsor.brandUrl : sponsor.profileUrl} target="_blank" rel="noopener noreferrer">
                  {sponsor.avatarUrl || sponsor.logoUrl ? <><img src={sponsor.avatarUrl || sponsor.logoUrl} alt="" width="32" height="32" loading="lazy" decoding="async" onerror="this.style.display='none'; this.nextElementSibling?.style.removeProperty('display')" /><span class="pricing-public-sponsor-fallback" aria-hidden="true" style="display:none">{(sponsor.brandName || sponsor.login || '?').slice(0, 1).toUpperCase()}</span></> : <span class="pricing-public-sponsor-fallback" aria-hidden="true">{(sponsor.brandName || sponsor.login || '?').slice(0, 1).toUpperCase()}</span>}
                  <span>{sponsor.brandName || sponsor.login}</span><ExternalLink size={14} stroke-width={1.8} aria-hidden="true" />
                </a></li>)}
              </ul>
            </div>
          })}
        </div>}
      </div>
    </div>
  </section>

  <section class:list={[shell, 'py-10']} id="plans" aria-label={locale === 'zh-CN' ? '开源社区入口' : 'Open source community path'}>
    <div data-reveal class="pricing-community-line">
      <p class="mb-0 text-sm leading-[1.7] text-copy-muted">{pricing.communityLine}</p>
      <a class="inline-flex min-h-11 items-center gap-2 text-sm font-[650] text-brand hover:text-ink" href={`${localizePath(locale)}#projects`} data-analytics-event="navigate_section" data-analytics-section="pricing_community">
        {pricing.communityAction}
        <ArrowRight size={16} stroke-width={1.8} aria-hidden="true" />
      </a>
    </div>
  </section>

  <section class="border-y border-line bg-panel-soft" id="services" aria-labelledby="pricing-services-title">
    <div class:list={[section, shell]}>
      <header data-reveal class="mb-12 max-w-[700px]">
        <p class="mb-3 font-mono text-xs font-[650] text-brand">{pricing.servicesKicker}</p>
        <h2 id="pricing-services-title" class={sectionTitle}>{pricing.servicesTitle}</h2>
      </header>
      <div class="pricing-service-list">
        {pricing.services.map((service, index) => (
          <article data-reveal style={`--reveal-delay: ${index * 60}ms`}>
            <span class="pricing-service-index">{String(index + 1).padStart(2, '0')}</span>
            <div><h3 class="mb-2 text-lg font-[660]">{service.name}</h3><p class="mb-0 text-sm text-copy-muted">{service.body}</p></div>
            <strong class="font-mono text-sm font-[700] max-[620px]:col-start-2">{service.price}</strong>
          </article>
        ))}
      </div>
      <p class="mt-7 mb-0 max-w-[720px] text-xs leading-[1.7] text-copy-muted">{pricing.servicesFootnote}</p>
    </div>
  </section>

  <section class:list={[section, shell]} id="support" aria-labelledby="pricing-support-title">
    <div class="grid grid-cols-[.72fr_1.28fr] gap-16 max-[900px]:grid-cols-1 max-[900px]:gap-10">
      <header data-reveal class="max-w-[470px]"><p class="mb-3 font-mono text-xs font-[650] text-brand">{pricing.slaKicker}</p><h2 id="pricing-support-title" class={sectionTitle}>{pricing.slaTitle}</h2></header>
      <div data-reveal class="overflow-x-auto border-t border-line">
        <table class="pricing-sla-table w-full border-collapse text-left text-sm"><caption class="sr-only">{locale === 'zh-CN' ? '支持响应级别' : 'Support response levels'}</caption><thead><tr><th scope="col">{pricing.slaTier}</th><th scope="col">{pricing.slaChannel}</th><th scope="col">{pricing.slaResponse}</th></tr></thead><tbody>{pricing.slaRows.map(row => <tr><th scope="row">{row.name}</th><td>{row.channel}</td><td>{row.response}</td></tr>)}</tbody></table>
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-panel" id="boundary" aria-labelledby="pricing-boundary-title">
    <div class:list={[section, shell]}>
      <header data-reveal class="mb-12 max-w-[700px]"><p class="mb-3 font-mono text-xs font-[650] text-brand">{pricing.boundaryKicker}</p><h2 id="pricing-boundary-title" class={sectionTitle}>{pricing.boundaryTitle}</h2></header>
      <div class="pricing-boundary-grid">{pricing.boundary.map((item, index) => <article data-reveal style={`--reveal-delay: ${index * 70}ms`}><span class="pricing-boundary-mark" aria-hidden="true">{index === 0 ? '+' : index === 1 ? '$' : 'x'}</span><h3 class="mb-2 text-xl font-[660]">{item.label}</h3><p class="mb-0 text-sm leading-[1.7] text-copy-muted">{item.body}</p></article>)}</div>
    </div>
  </section>

  <section class:list={[section, shell]} id="faq" aria-labelledby="pricing-faq-title">
    <div class="grid grid-cols-[.72fr_1.28fr] gap-16 max-[900px]:grid-cols-1 max-[900px]:gap-10">
      <header data-reveal class="max-w-[470px]"><p class="mb-3 font-mono text-xs font-[650] text-brand">{pricing.faqKicker}</p><h2 id="pricing-faq-title" class={sectionTitle}>{pricing.faqTitle}</h2></header>
      <div data-reveal class="border-t border-line">{pricing.faq.map(item => (
        <details class="group border-b border-line py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 pr-1 text-lg font-[650] [&::-webkit-details-marker]:hidden">
            {item.question}
            <ChevronDown class="shrink-0 transition-transform duration-200 group-open:rotate-180" size={20} stroke-width={1.8} aria-hidden="true" />
          </summary>
          <p class="mt-4 mb-1 max-w-[620px] text-sm leading-[1.75] text-copy-muted">{item.answer}</p>
        </details>
      ))}</div>
    </div>
  </section>

  <section class="pricing-cta border-t border-line bg-panel-soft" aria-labelledby="pricing-cta-title">
    <div data-reveal class:list={[shell, 'grid min-h-[260px] grid-cols-[1fr_auto] items-center gap-10 py-14 max-[720px]:grid-cols-1 max-[720px]:py-12']}>
      <div><h2 id="pricing-cta-title" class:list={[featuredTitle, 'mb-3 max-w-[700px]']}>{pricing.ctaTitle}</h2><p class="mb-0 max-w-[650px] text-copy-muted">{pricing.ctaBody}</p></div>
      <a class={buttonPrimary} href={githubUrl} target="_blank" rel="noopener noreferrer" data-analytics-event="click_outbound" data-analytics-target="pricing_cta"><GitFork size={18} stroke-width={1.9} aria-hidden="true" />{pricing.ctaAction}</a>
    </div>
  </section>
</main>

<style is:global>
  .pricing-hero { background: var(--background); color: var(--text); }
  .pricing-hero-inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, .38fr); gap: 3rem; align-items: end; min-height: 0; padding-top: 3.5rem; padding-bottom: 2.5rem; }
  .pricing-hero-note { display: flex; gap: 1rem; align-items: flex-start; max-width: 290px; padding-bottom: .5rem; color: var(--muted); font-size: .86rem; }
  .pricing-note-line { width: 2.5rem; height: 1px; margin-top: .7rem; flex: 0 0 auto; background: var(--accent); }
  .pricing-sponsor-split { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(260px, .9fr); gap: 1.5rem; align-items: start; }
  .pricing-sponsor-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; overflow: hidden; border: 1px solid var(--border); background: var(--border); }
  .pricing-sponsor-tier { display: flex; flex-direction: column; min-width: 0; min-height: 0; padding: 1.75rem; background: var(--surface); }
  .pricing-sponsor-note { padding: 1rem 1.15rem; border-radius: 8px; background: color-mix(in srgb, var(--surface) 88%, var(--border)); }
  .pricing-sponsor-button { margin-top: auto; width: fit-content; }
  .pricing-allocation-panel { min-width: 0; padding: 1.5rem; border: 1px solid var(--border); border-radius: 8px; background: color-mix(in srgb, var(--accent) 7%, var(--surface)); }
  .pricing-allocation-stack { display: grid; gap: 1rem; }
  .pricing-allocation-stack article { padding-top: 1rem; border-top: 1px solid var(--border); }
  .pricing-allocation-stack article:first-child { padding-top: 0; border-top: 0; }
  .pricing-community-line { display: flex; flex-wrap: wrap; gap: 0.75rem 1.25rem; align-items: center; justify-content: space-between; padding: 1rem 1.25rem; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); }
  .pricing-public-sponsors { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
  .pricing-public-sponsor-list { display: grid; gap: 1.25rem; }
  .pricing-public-sponsor-group ul { display: flex; flex-wrap: wrap; gap: .75rem; }
  .pricing-public-sponsor { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.5rem; padding: .35rem .65rem .35rem .35rem; border: 1px solid var(--border); color: var(--text); font-size: .85rem; }
  .pricing-public-sponsor:hover { background: var(--surface-soft); }
  .pricing-public-sponsor img, .pricing-public-sponsor-fallback { width: 2rem; height: 2rem; border-radius: 8px; object-fit: cover; background: color-mix(in srgb, var(--accent) 30%, transparent); display: grid; place-items: center; font: 650 .75rem/1 var(--font-mono); }
  .pricing-service-list { border-top: 1px solid var(--border); }
  .pricing-service-list article { display: grid; grid-template-columns: 2rem 1fr auto; gap: 1rem; align-items: center; min-height: 104px; border-bottom: 1px solid var(--border); }
  .pricing-service-index { color: var(--accent); font: 650 .7rem/1 var(--font-mono); }
  .pricing-sla-table th, .pricing-sla-table td { padding: 1rem .75rem 1rem 0; border-bottom: 1px solid var(--border); vertical-align: top; }
  .pricing-sla-table thead { color: var(--muted); font: 650 .75rem/1.2 var(--font-mono); }
  .pricing-sla-table tbody th { font-weight: 650; }
  .pricing-boundary-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; overflow: hidden; border: 1px solid var(--border); background: var(--border); }
  .pricing-boundary-grid article { min-height: 180px; padding: 1.5rem; background: var(--surface); }
  .pricing-boundary-mark { display: grid; place-items: center; width: 2rem; height: 2rem; margin-bottom: 1.5rem; border: 1px solid var(--accent); color: var(--accent); font: 650 1rem/1 var(--font-mono); }
  .pricing-cta .button-primary { background: var(--accent); color: var(--accent-contrast); }
  @media (max-width: 900px) {
    .pricing-sponsor-split { grid-template-columns: 1fr; }
    .pricing-boundary-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .pricing-hero-inner { grid-template-columns: 1fr; gap: 1.5rem; padding-top: 2.75rem; padding-bottom: 2rem; }
    .pricing-sponsor-grid { grid-template-columns: 1fr; }
    .pricing-service-list article { grid-template-columns: 2rem 1fr; padding: 1.2rem 0; }
    .pricing-service-list article > strong { grid-column: 2; }
  }
</style>
