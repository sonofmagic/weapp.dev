---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import HomePage from '../components/HomePage.astro'
import Footer from '../components/Footer.astro'
import { getProjects } from '../lib/projects'
import { loadProjectMetrics } from '../lib/metrics'
import { organizationSchema, projectListSchema, websiteSchema } from '../lib/seo'

const locale = 'zh-CN' as const
const projects = await getProjects()
const metrics = await loadProjectMetrics()
const title = 'weapp.dev | 小程序工程工具链'
const description = '面向真实小程序工程的开放工具链：weapp-vite 负责构建，weapp-tailwindcss 负责样式，Varo 负责组件交付，weapp-sqlite 规划本地数据能力，VPT 连接 Taro 与 React 团队。'
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  imageAlt="weapp.dev 小程序工程工具链地图"
  schemas={[organizationSchema(projects), websiteSchema(locale), projectListSchema(locale, projects)]}
>
  <Header locale={locale} projects={projects} currentPath={Astro.url.pathname} />
  <HomePage locale={locale} projects={projects} metrics={metrics} />
  <Footer locale={locale} projects={projects} currentPath={Astro.url.pathname} />
</BaseLayout>
