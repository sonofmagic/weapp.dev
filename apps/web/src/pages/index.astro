---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import HomePage from '../components/HomePage.astro'
import Footer from '../components/Footer.astro'
import { getProjects } from '../lib/projects'
import { loadProjectMetrics } from '../lib/metrics'

const locale = 'zh-CN' as const
const projects = await getProjects()
const metrics = await loadProjectMetrics()
const title = 'weapp.dev | 小程序开源工具栈'
const description = '面向小程序开发的开源工具栈，汇集 weapp-tailwindcss、weapp-vite 及后续生态项目。'
---

<BaseLayout locale={locale} title={title} description={description}>
  <Header locale={locale} projects={projects} currentPath={Astro.url.pathname} />
  <HomePage locale={locale} projects={projects} metrics={metrics} />
  <Footer locale={locale} projects={projects} />
</BaseLayout>
