---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import NotFoundPage from '../components/NotFoundPage.astro'
import { getProjects } from '../lib/projects'
import { siteCopy } from '../i18n/ui'

const locale = 'zh-CN' as const
const copy = siteCopy[locale]
const projects = await getProjects()
---

<BaseLayout locale={locale} title={`${copy.notFound.title} | weapp.dev`} description={copy.notFound.description} noindex>
  <Header locale={locale} projects={projects} currentPath={Astro.url.pathname} />
  <NotFoundPage locale={locale} />
  <Footer locale={locale} projects={projects} />
</BaseLayout>
