---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from '../../components/Header.astro'
import HomePage from '../../components/HomePage.astro'
import Footer from '../../components/Footer.astro'
import { getProjects } from '../../lib/projects'
import { loadProjectMetrics } from '../../lib/metrics'
import { organizationSchema, projectListSchema, websiteSchema } from '../../lib/seo'

const locale = 'en' as const
const projects = await getProjects()
const metrics = await loadProjectMetrics()
const title = 'weapp.dev | Styling, build, and UI tools for mini-apps'
const description = 'Open tooling for real mini-app projects: cross-platform styling with weapp-tailwindcss, Vite-powered development with weapp-vite, and editable Vue and Agent UI source with Varo.'
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  imageAlt="weapp.dev styling and build tools for mini-apps"
  schemas={[organizationSchema(projects), websiteSchema(locale), projectListSchema(locale, projects)]}
>
  <Header locale={locale} projects={projects} currentPath={Astro.url.pathname} />
  <HomePage locale={locale} projects={projects} metrics={metrics} />
  <Footer locale={locale} projects={projects} />
</BaseLayout>
