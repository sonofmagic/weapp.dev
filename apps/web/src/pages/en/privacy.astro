---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Footer from '../../components/Footer.astro'
import Header from '../../components/Header.astro'
import PrivacyPage from '../../components/PrivacyPage.astro'
import { getProjects } from '../../lib/projects'
import { siteCopy } from '../../i18n/ui'

const locale = 'en' as const
const copy = siteCopy[locale].privacy
const projects = await getProjects()
---

<BaseLayout locale={locale} title={`${copy.title} | weapp.dev`} description={copy.description}>
  <Header locale={locale} projects={projects} currentPath={Astro.url.pathname} />
  <PrivacyPage locale={locale} />
  <Footer locale={locale} projects={projects} />
</BaseLayout>
