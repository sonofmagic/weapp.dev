---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import SponsorsPage from '../../components/SponsorsPage.astro'
import { sponsorsSchema } from '../../lib/seo'
import { getProjects } from '../../lib/projects'
const projects = await getProjects()
---
<BaseLayout locale="en" title="Sponsor graph | weapp.dev" description="Public sponsorship, project maintenance and contributors fund graph" schemas={[sponsorsSchema('en')]}><Header locale="en" projects={projects} currentPath={Astro.url.pathname} /><SponsorsPage locale="en" /><Footer locale="en" projects={projects} currentPath={Astro.url.pathname} /></BaseLayout>
