---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import Header from '../../../components/Header.astro'
import Footer from '../../../components/Footer.astro'
import ProjectsIndexPage from '../../../components/ProjectsIndexPage.astro'
import { getProjects } from '../../../lib/projects'
const projects = await getProjects()
---
<BaseLayout locale="en" title="Toolchain projects | weapp.dev" description="The five core weapp.dev toolchain projects"><Header locale="en" projects={projects} currentPath={Astro.url.pathname} /><ProjectsIndexPage locale="en" projects={projects} /><Footer locale="en" projects={projects} /></BaseLayout>
