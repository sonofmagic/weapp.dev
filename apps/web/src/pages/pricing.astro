---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import PricingPage from '../components/PricingPage.astro'
import Footer from '../components/Footer.astro'
import { getProjects } from '../lib/projects'
import { pricingSchema } from '../lib/seo'

const locale = 'zh-CN' as const
const projects = await getProjects()
const title = '开源赞助与分账 | weapp.dev'
const description = 'weapp.dev 的开源赞助档位、60/25/15 分账说明，以及可交付的迁移与培训服务。'
---

<BaseLayout locale={locale} title={title} description={description} imageAlt="weapp.dev 商业化交付层" schemas={[pricingSchema(locale)]}>
  <Header locale={locale} projects={projects} currentPath={Astro.url.pathname} />
  <PricingPage locale={locale} />
  <Footer locale={locale} projects={projects} currentPath={Astro.url.pathname} />
</BaseLayout>
