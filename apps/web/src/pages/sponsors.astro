---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import SponsorsPage from '../components/SponsorsPage.astro'
import { getProjects } from '../lib/projects'
const projects = await getProjects()
---
<BaseLayout locale="zh-CN" title="赞助图谱 | weapp.dev" description="公开赞助、项目维护与贡献者基金图谱"><Header locale="zh-CN" projects={projects} currentPath={Astro.url.pathname} /><SponsorsPage locale="zh-CN" /><Footer locale="zh-CN" projects={projects} /></BaseLayout>
