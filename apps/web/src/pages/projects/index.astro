---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import ProjectsIndexPage from '../../components/ProjectsIndexPage.astro'
import { getProjects } from '../../lib/projects'
import { projectListSchema } from '../../lib/seo'
const projects = await getProjects()
---
<BaseLayout locale="zh-CN" title="工具链项目 | weapp.dev" description="weapp.dev 五个核心工具链项目" schemas={[projectListSchema('zh-CN', projects)]}><Header locale="zh-CN" projects={projects} currentPath={Astro.url.pathname} /><ProjectsIndexPage locale="zh-CN" projects={projects} /><Footer locale="zh-CN" projects={projects} currentPath={Astro.url.pathname} /></BaseLayout>
